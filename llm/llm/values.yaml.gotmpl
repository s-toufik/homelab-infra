image:
  repository: ghcr.io/mostlygeek/llama-swap
  tag: {{ .Values.images.llamaSwap | quote }}

args: [-config, /config/config.yml, -listen, ":8080"]

env:
  LLAMA_CACHE: /models

ports:
  - { name: http, port: 8080 }

probes:
  startup:
    httpGet: { path: /health, port: http }
    periodSeconds: 10
    failureThreshold: 360
  readiness:
    httpGet: { path: /health, port: http }
    periodSeconds: 15
  liveness:
    httpGet: { path: /health, port: http }
    periodSeconds: 30
    failureThreshold: 5

resources:
  requests: { cpu: "1", memory: 8Gi }
  limits: { memory: 26Gi }

persistence:
  models:
    mountPath: /models
    size: 100Gi

configFiles:
  config:
    mountPath: /config
    files:
      config.yml: |
        {{- readFile "config.yml" | nindent 8 }}

terminationGracePeriodSeconds: 60

image:
  repository: grafana/mcp-grafana
  tag: {{ .Values.images.grafanaMcp | quote }}

command: [/app/mcp-grafana]
args:
  - --transport=streamable-http
  - --address=0.0.0.0:8000
  - --enabled-tools={{ .Values.mcp.grafana.categories }}
{{- if not .Values.mcp.grafana.write }}
  - --disable-write
{{- end }}

env:
  GRAFANA_URL: http://grafana:3000
secretEnv:
  GRAFANA_SERVICE_ACCOUNT_TOKEN: { secret: grafana-mcp, key: token }

ports:
  - { name: http, port: 8000 }

probes:
  readiness:
    tcpSocket: { port: http }
    periodSeconds: 10
  liveness:
    tcpSocket: { port: http }
    periodSeconds: 20

resources:
  requests: { cpu: 10m, memory: 32Mi }
  limits: { memory: 128Mi }

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
  runAsGroup: 1000
securityContext:
  readOnlyRootFilesystem: true

networkPolicy:
  ingress:
    - from:
        - podSelector: { matchLabels: { app.kubernetes.io/name: agent-toolbox } }
      ports: [{ protocol: TCP, port: 8000 }]
  egress:
    - to:
        - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: kube-system } }
          podSelector: { matchLabels: { k8s-app: kube-dns } }
      ports: [{ protocol: UDP, port: 53 }, { protocol: TCP, port: 53 }]
    - to:
        - podSelector: { matchLabels: { app.kubernetes.io/name: grafana } }
      ports: [{ protocol: TCP, port: 3000 }]

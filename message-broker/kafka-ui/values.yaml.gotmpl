image:
  repository: ghcr.io/kafbat/kafka-ui
  tag: {{ .Values.images.kafkaUi | quote }}

env:
  KAFKA_CLUSTERS_0_NAME: homelab
  KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS: kafka:9092
  DYNAMIC_CONFIG_ENABLED: "false"
  LOGGING_LEVEL_ROOT: warn
  LOGGING_CONFIG: /etc/kafka-ui-logging/logback.xml
  JAVA_OPTS: -Xms256m -Xmx512m

ports:
  - { name: http, port: 8080 }

probes:
  startup:
    httpGet: { path: /actuator/health, port: http }
    periodSeconds: 5
    failureThreshold: 36
  readiness:
    httpGet: { path: /actuator/health, port: http }
    periodSeconds: 15
  liveness:
    httpGet: { path: /actuator/health, port: http }
    periodSeconds: 30
    failureThreshold: 5

configFiles:
  logging:
    mountPath: /etc/kafka-ui-logging
    files:
      logback.xml: |
        {{- readFile "logback.xml" | nindent 8 }}

resources:
  requests: { cpu: 50m, memory: 384Mi }
  limits: { memory: 768Mi }

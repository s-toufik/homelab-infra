kind: None

image:
  repository: ghcr.io/amacneil/dbmate
  tag: {{ .Values.images.dbmate | quote }}

configFiles:
  migrations:
    mountPath: /db/migrations
    files:
{{- range $path := readDir "migrations" }}
      {{ base $path }}: |
        {{- readFile $path | nindent 8 }}
{{- end }}

jobs:
  migrate:
    args: [--wait, --wait-timeout, 5m, migrate]
    configFiles: [migrations]
    env:
      DATABASE_URL: postgres://postgres@postgres-rw:5432/homelab?sslmode=require
      DBMATE_MIGRATIONS_DIR: /db/migrations
      DBMATE_NO_DUMP_SCHEMA: "true"
    secretEnv:
      PGPASSWORD: { secret: postgres-superuser, key: password }
    resources:
      requests: { cpu: 10m, memory: 16Mi }
      limits: { memory: 64Mi }

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 65534
securityContext:
  readOnlyRootFilesystem: true

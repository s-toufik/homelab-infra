imageName: ghcr.io/cloudnative-pg/postgresql:{{ .Values.images.postgres }}

storage:
  size: 20Gi

parameters:
  shared_buffers: 1GB
  effective_cache_size: 3GB
  work_mem: 16MB
  maintenance_work_mem: 256MB
  max_connections: "200"
  wal_compression: "on"

resources:
  requests: { cpu: 250m, memory: 1Gi }
  limits: { memory: 4Gi }

roles:
  - name: tasker_web
    login: false
  - name: postgrest
    login: true
    inherit: false
    inRoles: [tasker_web]
    passwordSecret: { name: pg-role-postgrest }
  - name: keycloak
    login: true
    passwordSecret: { name: pg-role-keycloak }

databases:
  - name: keycloak
    owner: keycloak

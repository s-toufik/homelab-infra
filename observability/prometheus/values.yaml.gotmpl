kind: StatefulSet

image:
  repository: prom/prometheus
  tag: {{ .Values.images.prometheus | quote }}

args:
  - --config.file=/etc/prometheus/prometheus.yml
  - --storage.tsdb.path=/prometheus
  - --storage.tsdb.retention.time={{ .Values.prometheus.retentionTime }}
  - --storage.tsdb.retention.size={{ .Values.prometheus.retentionSize }}
  - --web.enable-remote-write-receiver
  - --web.enable-otlp-receiver
  - --enable-feature=exemplar-storage

ports:
  - { name: http, port: 9090 }

probes:
  startup:
    httpGet: { path: /-/ready, port: http }
    periodSeconds: 5
    failureThreshold: 60
  readiness:
    httpGet: { path: /-/ready, port: http }
    periodSeconds: 10
  liveness:
    httpGet: { path: /-/healthy, port: http }
    periodSeconds: 20
    failureThreshold: 6

resources:
  requests: { cpu: 200m, memory: 1Gi }
  limits: { memory: 3Gi }

persistence:
  data:
    mountPath: /prometheus
    size: 60Gi

configFiles:
  config:
    mountPath: /etc/prometheus
    files:
      prometheus.yml: |
        {{- readFile "prometheus.yml" | nindent 8 }}

rbac:
  rules:
    - apiGroups: [""]
      resources: [pods]
      verbs: [get, list, watch]

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 65534
  runAsGroup: 65534
securityContext:
  readOnlyRootFilesystem: true

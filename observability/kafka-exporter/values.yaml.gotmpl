image:
  repository: danielqsj/kafka-exporter
  tag: {{ .Values.images.kafkaExporter | quote }}

args:
  - --kafka.server=kafka:9092
  - --kafka.version=3.6.0
  - --topic.filter=^[^_].*
  - --log.level=warn

ports:
  - { name: metrics, port: 9308 }

probes:
  readiness:
    tcpSocket: { port: metrics }
    periodSeconds: 15
  liveness:
    tcpSocket: { port: metrics }
    periodSeconds: 30
    failureThreshold: 5

metrics:
  port: 9308

resources:
  requests: { cpu: 10m, memory: 32Mi }
  limits: { memory: 128Mi }

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 65534
securityContext:
  readOnlyRootFilesystem: true

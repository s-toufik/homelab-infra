image:
  repository: grafana/grafana
  tag: {{ .Values.images.grafana | quote }}

env:
  GF_USERS_ALLOW_SIGN_UP: "false"
  GF_ANALYTICS_REPORTING_ENABLED: "false"
  GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
  GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH: /etc/grafana/dashboards/homelab-overview.json
  GF_INSTALL_PLUGINS: yesoreyeram-infinity-datasource
  GF_SERVER_ROOT_URL: https://{{ .Values.domain }}:3000/
  GF_AUTH_OAUTH_AUTO_LOGIN: "true"
  GF_AUTH_GENERIC_OAUTH_ENABLED: "true"
  GF_AUTH_GENERIC_OAUTH_NAME: Homelab
  GF_AUTH_GENERIC_OAUTH_CLIENT_ID: grafana
  GF_AUTH_GENERIC_OAUTH_SCOPES: openid email profile
  GF_AUTH_GENERIC_OAUTH_AUTH_URL: https://{{ .Values.domain }}:8443/realms/homelab/protocol/openid-connect/auth
  GF_AUTH_GENERIC_OAUTH_TOKEN_URL: https://{{ .Values.domain }}:8443/realms/homelab/protocol/openid-connect/token
  GF_AUTH_GENERIC_OAUTH_API_URL: https://{{ .Values.domain }}:8443/realms/homelab/protocol/openid-connect/userinfo
  GF_AUTH_GENERIC_OAUTH_USE_PKCE: "true"
  GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH: preferred_username
  GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH: name
  GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH: email
  GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: "contains(roles[*], 'admin') && 'Admin' || 'Viewer'"
  GF_AUTH_SIGNOUT_REDIRECT_URL: https://{{ .Values.domain }}:8443/realms/homelab/protocol/openid-connect/logout?client_id=grafana&post_logout_redirect_uri=https%3A%2F%2F{{ .Values.domain }}%3A3000%2Flogin
secretEnv:
  GF_SECURITY_ADMIN_USER: { secret: grafana-admin, key: username }
  GF_SECURITY_ADMIN_PASSWORD: { secret: grafana-admin, key: password }
  GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: { secret: grafana-oidc, key: client-secret }

ports:
  - { name: http, port: 3000 }

probes:
  startup:
    httpGet: { path: /api/health, port: http }
    periodSeconds: 5
    failureThreshold: 60
  readiness:
    httpGet: { path: /api/health, port: http }
    periodSeconds: 10
  liveness:
    httpGet: { path: /api/health, port: http }
    periodSeconds: 30
    failureThreshold: 5

metrics:
  port: 3000

resources:
  requests: { cpu: 50m, memory: 256Mi }
  limits: { memory: 768Mi }

persistence:
  data:
    mountPath: /var/lib/grafana
    size: 5Gi

configFiles:
  datasources:
    mountPath: /etc/grafana/provisioning/datasources
    files:
      datasources.yml: |
        {{- readFile "provisioning/datasources/datasources.yml" | nindent 8 }}
  providers:
    mountPath: /etc/grafana/provisioning/dashboards
    files:
      dashboards.yml: |
        {{- readFile "provisioning/dashboards/dashboards.yml" | nindent 8 }}
  dashboards:
    mountPath: /etc/grafana/dashboards
    files:
{{- range $path := readDir "dashboards" }}
      {{ base $path }}: |
        {{- readFile $path | nindent 8 }}
{{- end }}

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 472
  runAsGroup: 0

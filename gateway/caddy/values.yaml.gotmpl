# Caddy: HTTPS (Tailscale certificate) and the sign-in check in front of every web interface.
# Its ports listen on the Tailscale address only; the routes are in ./Caddyfile.
image:
  repository: caddy
  tag: {{ .Values.images.caddy | quote }}

env:
  HOMELAB_DOMAIN: {{ .Values.domain | quote }}
secretEnv:
  TASKER_GATEWAY_SECRET: { secret: tasker-gateway, key: secret }
  LLM_GATEWAY_API_KEY: { secret: llm-gateway, key: api-key }

ports:
  - { name: https, port: 443, hostPort: 443 }               # homelab-ui and its APIs
  - { name: signin, port: 8443, hostPort: 8443 }            # Keycloak sign-in pages
  - { name: grafana, port: 3000, hostPort: 3000 }           # Grafana (signs in with Keycloak)
  - { name: prometheus, port: 9090, hostPort: 9090 }
  - { name: kafka-ui, port: 8080, hostPort: 8080 }
  - { name: alloy, port: 12345, hostPort: 12345 }
  - { name: llm, port: 8090, hostPort: 8090 }               # LLM playground and API (API key accepted)
  - { name: loki, port: 3100, hostPort: 3100 }
  - { name: tempo, port: 3200, hostPort: 3200 }
  - { name: kafka-exporter, port: 9308, hostPort: 9308 }
  - { name: mcp-inspector, port: 6274, hostPort: 6274 }     # agent-toolbox's tools in the browser

probes:
  readiness:
    tcpSocket: { port: https }
    periodSeconds: 10
  liveness:
    tcpSocket: { port: https }
    periodSeconds: 20
    failureThreshold: 6

resources:
  requests: { cpu: 50m, memory: 64Mi }
  limits: { memory: 256Mi }

# Runs as root, like the image: the Tailscale daemon only hands certificates to root.
# It keeps one capability, to listen on port 443.
securityContext:
  readOnlyRootFilesystem: true
  capabilities:
    add: [NET_BIND_SERVICE]

persistence:
  data:
    mountPath: /data
    size: 1Gi
  config:
    mountPath: /config
    size: 100Mi

configFiles:
  caddyfile:
    mountPath: /etc/caddy
    files:
      Caddyfile: |
        {{- readFile "Caddyfile" | nindent 8 }}

extraVolumes:
  # Certificates for *.ts.net come from the server's Tailscale daemon
  - name: tailscale
    hostPath:
      path: /run/tailscale/tailscaled.sock
      type: Socket
  - name: tmp
    emptyDir: {}
extraVolumeMounts:
  - name: tailscale
    mountPath: /var/run/tailscale/tailscaled.sock
  - name: tmp
    mountPath: /tmp

extraManifests:
  # Pods that check sign-ins (oauth2-proxy, Grafana) reach https://<domain>:8443 through this
  # Caddy, as browsers do: the cluster's DNS answers the Tailscale name with Caddy's Service.
  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: coredns-custom
      namespace: kube-system
    data:
      homelab.override: |
        rewrite name exact {{ .Values.domain }} caddy.homelab.svc.cluster.local

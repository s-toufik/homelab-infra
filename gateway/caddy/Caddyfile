	route {
		import strip_identity
		import signed_in_page
		reverse_proxy mcp-inspector:6274 {
			flush_interval -1
			header_up Host mcp-inspector:6274
			header_up -Cookie
		}
	}
}

{$HOMELAB_DOMAIN}:4466 {
	route {
		import strip_identity
		import signed_in_page
		import admin_only *
		reverse_proxy headlamp:4466 {
			flush_interval -1
			header_up -Cookie
		}
	}
}

{$HOMELAB_DOMAIN}:8100 {
	route {
		import strip_identity
		import signed_in_page
		reverse_proxy agent-runtime:8000 {
			flush_interval -1
			header_up -Cookie
		}
	}
}

{$HOMELAB_DOMAIN}:8090 {
	@api_key header Authorization "Bearer {$LLM_GATEWAY_API_KEY}"

	route {
		import strip_identity

		handle @api_key {
			reverse_proxy llm:8080 {
				flush_interval -1
				header_up -Authorization
			}
		}

		handle /v1/* {
			import signed_in_api
			reverse_proxy llm:8080 {
				flush_interval -1
				header_up -Cookie
			}
		}

		handle {
			import signed_in_page
			reverse_proxy llm:8080 {
				flush_interval -1
				header_up -Cookie
			}
		}
	}
}

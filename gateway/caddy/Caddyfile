{
	auto_https disable_redirects
}

# Identity headers are set only by the gateway, never by the browser.
(strip_identity) {
	request_header -Remote-User
	request_header -Remote-Email
	request_header -X-Gateway-Secret
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Preferred-Username
	request_header -X-Auth-Request-Groups
	request_header -X-Auth-Request-Access-Token
}

# Pages: signed-out visitors go to the sign-in page, then come back to the same address.
(signed_in_page) {
	forward_auth oauth2-proxy:4180 {
		uri /oauth2/auth
		header_up X-Real-IP {remote_host}
		copy_headers X-Auth-Request-Preferred-Username>Remote-User X-Auth-Request-Email>Remote-Email

		@signed_out status 401
		handle_response @signed_out {
			redir * https://{$HOMELAB_DOMAIN}/oauth2/sign_in?rd={scheme}://{http.request.hostport}{uri}
		}
	}
}

# APIs: signed-out calls get 401 instead of a redirect.
(signed_in_api) {
	forward_auth oauth2-proxy:4180 {
		uri /oauth2/auth
		header_up X-Real-IP {remote_host}
		copy_headers X-Auth-Request-Preferred-Username>Remote-User X-Auth-Request-Email>Remote-Email

		@signed_out status 401
		handle_response @signed_out {
			respond "Sign in required" 401
		}
	}
}

# Health route: /api/health/<name> → the container's own readiness endpoint (inside /api/*, so
# signed in). Arguments: name, upstream host:port, health path.
(health_route) {
	handle /api/health/{args[0]} {
		rewrite * {args[2]}
		reverse_proxy {args[1]} {
			header_up -Cookie
		}
	}
}

# A tool behind the sign-in, on its usual port. Browser cookies (the session) are not passed on.
(signed_in_tool) {
	route {
		import strip_identity
		import signed_in_page
		reverse_proxy {args[0]} {
			header_up -Cookie
		}
	}
}

# homelab-ui, the APIs it calls, and the sign-in endpoints
{$HOMELAB_DOMAIN} {
	route {
		import strip_identity

		# Answered by Caddy itself: proves HTTPS and the certificate work, reveals nothing.
		handle /healthz {
			respond "OK" 200
		}

		handle /oauth2/* {
			reverse_proxy oauth2-proxy:4180 {
				header_up X-Real-IP {remote_host}
			}
		}

		handle /api/* {
			import signed_in_api

			handle_path /api/tasker/* {
				reverse_proxy postgrest:3000 {
					header_up X-Gateway-Secret {$TASKER_GATEWAY_SECRET}
					header_up -Authorization
					header_up -Cookie
				}
			}

			handle_path /api/agent/* {
				@blocked not path /v1/* /actuator/health/*
				respond @blocked 404
				reverse_proxy agent-runtime:8000 {
					flush_interval -1
					header_up -Cookie
				}
			}

			handle_path /api/prometheus/* {
				@blocked not path /api/v1/query /api/v1/query_range
				respond @blocked 404
				reverse_proxy prometheus:9090 {
					header_up -Cookie
				}
			}

			# Readiness of every container, for homelab-ui's Status page: /api/health/<name>
			handle /api/health/caddy {
				respond "OK" 200
			}
			import health_route homelab-ui homelab-ui:8080 /
			import health_route keycloak keycloak:9000 /health/ready
			import health_route oauth2-proxy oauth2-proxy:4180 /ping
			import health_route postgrest postgrest:3002 /ready
			import health_route kafka-ui kafka-ui:8080 /actuator/health
			import health_route prometheus prometheus:9090 /-/ready
			import health_route cadvisor cadvisor:8080 /healthz
			import health_route kafka-exporter kafka-exporter:9308 /metrics
			import health_route postgres-exporter postgres-exporter:9187 /metrics
			import health_route mongodb-exporter mongodb-exporter:9216 /metrics
			import health_route loki loki:3100 /ready
			import health_route tempo tempo:3200 /ready
			import health_route otel-collector otel-collector:13133 /
			import health_route alloy alloy:12345 /-/ready
			import health_route grafana grafana:3000 /api/health
			import health_route llm llm:8080 /health
			import health_route agent-runtime agent-runtime:8000 /actuator/health/readiness
			# agent-toolbox and the MCP Inspector only answer requests addressed to their own host name
			handle /api/health/agent-toolbox {
				rewrite * /actuator/health
				reverse_proxy agent-toolbox:8001 {
					header_up Host agent-toolbox:8001
					header_up -Cookie
				}
			}
			handle /api/health/mcp-inspector {
				rewrite * /
				reverse_proxy mcp-inspector:6274 {
					header_up Host mcp-inspector:6274
					header_up -Cookie
				}
			}

			respond "Not found" 404
		}

		handle {
			import signed_in_page
			reverse_proxy homelab-ui:8080 {
				header_up -Cookie
			}
		}
	}
}

# Keycloak: login, password change and sign-out pages. Accounts are managed from the terminal.
{$HOMELAB_DOMAIN}:8443 {
	@admin path /admin /admin/*
	respond @admin "Not available" 403

	reverse_proxy keycloak:8080
}

# Grafana signs in with Keycloak itself (single sign-on, roles from Keycloak).
{$HOMELAB_DOMAIN}:3000 {
	route {
		import strip_identity
		reverse_proxy grafana:3000
	}
}

# Prometheus: the lifecycle endpoints stay off the network (use `make reload-prometheus`).
{$HOMELAB_DOMAIN}:9090 {
	route {
		import strip_identity
		import signed_in_page
		@lifecycle path /-/quit /-/reload
		respond @lifecycle "Not available" 403
		reverse_proxy prometheus:9090 {
			header_up -Cookie
		}
	}
}

{$HOMELAB_DOMAIN}:8080 {
	import signed_in_tool kafka-ui:8080
}

{$HOMELAB_DOMAIN}:12345 {
	import signed_in_tool alloy:12345
}

{$HOMELAB_DOMAIN}:3100 {
	import signed_in_tool loki:3100
}

{$HOMELAB_DOMAIN}:3200 {
	import signed_in_tool tempo:3200
}

{$HOMELAB_DOMAIN}:9308 {
	import signed_in_tool kafka-exporter:9308
}

# MCP Inspector: agent-toolbox's tools in the browser. It checks the Host header against its own name,
# and the browser's Origin against https://<HOMELAB_DOMAIN>:6274 (ALLOWED_ORIGINS).
{$HOMELAB_DOMAIN}:6274 {
	route {
		import strip_identity
		import signed_in_page
		reverse_proxy mcp-inspector:6274 {
			flush_interval -1
			header_up Host mcp-inspector:6274
			header_up -Cookie
		}
	}
}

# LLM: the playground needs a sign-in; scripts and OpenAI clients use the API key instead.
{$HOMELAB_DOMAIN}:8090 {
	@api_key header Authorization "Bearer {$LLM_GATEWAY_API_KEY}"

	route {
		import strip_identity

		handle @api_key {
			reverse_proxy llm:8080 {
				flush_interval -1
				header_up -Authorization
			}
		}

		handle /v1/* {
			import signed_in_api
			reverse_proxy llm:8080 {
				flush_interval -1
				header_up -Cookie
			}
		}

		handle {
			import signed_in_page
			reverse_proxy llm:8080 {
				flush_interval -1
				header_up -Cookie
			}
		}
	}
}

# Old homelab-ui address
:8002 {
	redir https://{$HOMELAB_DOMAIN}{uri} permanent
}

{
	auto_https disable_redirects
}

(strip_identity) {
	request_header -Remote-User
	request_header -Remote-Email
	request_header -X-Gateway-Secret
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Preferred-Username
	request_header -X-Auth-Request-Groups
	request_header -X-Auth-Request-Access-Token
}

(signed_in_page) {
	forward_auth oauth2-proxy:4180 {
		uri /oauth2/auth
		header_up X-Real-IP {remote_host}
		copy_headers X-Auth-Request-Preferred-Username>Remote-User X-Auth-Request-Email>Remote-Email

		@signed_out status 401
		handle_response @signed_out {
			redir * https://{$HOMELAB_DOMAIN}/oauth2/sign_in?rd={scheme}://{http.request.hostport}{uri}
		}
	}
}

(signed_in_api) {
	forward_auth oauth2-proxy:4180 {
		uri /oauth2/auth
		header_up X-Real-IP {remote_host}
		copy_headers X-Auth-Request-Preferred-Username>Remote-User X-Auth-Request-Email>Remote-Email

		@signed_out status 401
		handle_response @signed_out {
			respond "Sign in required" 401
		}
	}
}

(admin_only) {
	forward_auth {args[0]} oauth2-proxy:4180 {
		uri /oauth2/auth?allowed_groups=role:admin
		header_up X-Real-IP {remote_host}

		@signed_out status 401
		handle_response @signed_out {
			respond "Sign in required" 401
		}
	}
}

(no_cross_site_writes) {
	@cross_site_write {
		not method GET HEAD OPTIONS
		not header X-Homelab-Request 1
	}
	respond @cross_site_write "Missing X-Homelab-Request" 403
}

(read_only) {
	@write not method GET HEAD
	respond @write "Read-only" 405
}

(health_route) {
	handle /api/health/{args[0]} {
		rewrite * {args[2]}
		reverse_proxy {args[1]} {
			header_up -Cookie
		}
	}
}

(signed_in_tool) {
	route {
		import strip_identity
		import signed_in_page
		reverse_proxy {args[0]} {
			header_up -Cookie
		}
	}
}

{$HOMELAB_DOMAIN} {
	route {
		import strip_identity

		handle /healthz {
			respond "OK" 200
		}

		handle /oauth2/* {
			reverse_proxy oauth2-proxy:4180 {
				header_up X-Real-IP {remote_host}
			}
		}

		handle /api/* {
			import signed_in_api

			handle_path /api/tasker/* {
				reverse_proxy postgrest:3000 {
					header_up X-Gateway-Secret {$TASKER_GATEWAY_SECRET}
					header_up -Authorization
					header_up -Cookie
				}
			}

			handle_path /api/agent/* {
				@blocked not path /v1/* /actuator/health/*
				respond @blocked 404
				reverse_proxy agent-runtime:8000 {
					flush_interval -1
					header_up -Cookie
				}
			}

			handle_path /api/prometheus/* {
				@blocked not path /api/v1/query /api/v1/query_range /api/v1/series /api/v1/labels /api/v1/label/*/values /api/v1/targets /api/v1/rules /api/v1/alerts /api/v1/metadata
				respond @blocked 404
				import read_only
				reverse_proxy prometheus:9090 {
					header_up -Cookie
				}
			}

			handle_path /api/loki/* {
				@blocked not path /loki/api/v1/query /loki/api/v1/query_range /loki/api/v1/labels /loki/api/v1/label/*/values /loki/api/v1/series
				respond @blocked 404
				import read_only
				reverse_proxy loki:3100 {
					header_up -Cookie
				}
			}

			handle_path /api/tempo/* {
				@blocked not path /api/search /api/search/tags /api/v2/search/tags /api/v2/search/tag/*/values /api/traces/* /api/v2/traces/*
				respond @blocked 404
				import read_only
				reverse_proxy tempo:3200 {
					header_up -Cookie
				}
			}

			handle_path /api/alloy/* {
				@blocked not path /api/v0/web/components /api/v0/web/components/*
				respond @blocked 404
				import read_only
				reverse_proxy alloy:12346 {
					header_up -Cookie
				}
			}

			handle_path /api/kafka/* {
				@blocked not path /api/clusters /api/clusters/*
				respond @blocked 404
				import no_cross_site_writes
				@kafka_write not method GET HEAD
				import admin_only @kafka_write
				reverse_proxy kafka-ui:8080 {
					flush_interval -1
					header_up -Cookie
				}
			}

			handle_path /api/llm/* {
				@blocked not path /v1/models /v1/chat/completions /running /logs /logs/stream /logs/stream/* /api/models/unload /api/models/unload/*
				respond @blocked 404
				import no_cross_site_writes
				@llm_unload path /api/models/unload /api/models/unload/*
				import admin_only @llm_unload
				reverse_proxy llm:8080 {
					flush_interval -1
					header_up -Cookie
				}
			}

			handle_path /api/toolbox/* {
				@blocked not path /mcp /mcp/*
				respond @blocked 404
				import no_cross_site_writes
				reverse_proxy agent-toolbox:8001 {
					flush_interval -1
					header_up Host agent-toolbox:8001
					header_up -Origin
					header_up -Cookie
				}
			}

			handle_path /api/account/* {
				import no_cross_site_writes
				forward_auth oauth2-proxy:4180 {
					uri /oauth2/auth
					header_up X-Real-IP {remote_host}
					copy_headers X-Auth-Request-Access-Token
				}
				rewrite * /realms/homelab/account{uri}
				reverse_proxy keycloak:8080 {
					header_up Authorization "Bearer {http.request.header.X-Auth-Request-Access-Token}"
					header_up -X-Auth-Request-Access-Token
					header_up -Cookie
				}
			}

			handle_path /api/kube/* {
				import admin_only *
				import no_cross_site_writes
				reverse_proxy kube-api:8001 {
					flush_interval -1
					header_up Host kube-api:8001
					header_up -Authorization
					header_up -Cookie
				}
			}

			handle /api/health/caddy {
				respond "OK" 200
			}
			import health_route homelab-ui homelab-ui:8080 /
			import health_route keycloak keycloak:9000 /health/ready
			import health_route oauth2-proxy oauth2-proxy:4180 /ping
			import health_route postgrest postgrest:3002 /ready
			import health_route kafka-ui kafka-ui:8080 /actuator/health
			import health_route prometheus prometheus:9090 /-/ready
			import health_route kafka-exporter kafka-exporter:9308 /metrics
			import health_route mongodb-exporter mongodb-exporter:9216 /metrics
			import health_route loki loki:3100 /ready
			import health_route tempo tempo:3200 /ready
			import health_route otel-collector otel-collector:13133 /
			import health_route alloy alloy:12346 /-/ready
			handle /api/health/kube-api {
				rewrite * /readyz
				reverse_proxy kube-api:8001 {
					header_up Host kube-api:8001
					header_up -Cookie
				}
			}
			import health_route headlamp headlamp:4466 /
			import health_route grafana grafana:3000 /api/health
			import health_route llm llm:8080 /health
			import health_route llm-sd llm-sd:8000 /targets
			import health_route agent-runtime agent-runtime:8000 /actuator/health/readiness
			handle /api/health/agent-toolbox {
				rewrite * /actuator/health
				reverse_proxy agent-toolbox:8001 {
					header_up Host agent-toolbox:8001
					header_up -Cookie
				}
			}
			handle /api/health/mcp-inspector {
				rewrite * /
				reverse_proxy mcp-inspector:6274 {
					header_up Host mcp-inspector:6274
					header_up -Cookie
				}
			}

			respond "Not found" 404
		}

		handle {
			import signed_in_page
			reverse_proxy homelab-ui:8080 {
				header_up -Cookie
			}
		}
	}
}

{$HOMELAB_DOMAIN}:8443 {
	@admin path /admin /admin/*
	respond @admin "Not available" 403

	reverse_proxy keycloak:8080
}

{$HOMELAB_DOMAIN}:3000 {
	route {
		import strip_identity
		reverse_proxy grafana:3000
	}
}

{$HOMELAB_DOMAIN}:9090 {
	route {
		import strip_identity
		import signed_in_page
		@lifecycle path /-/quit /-/reload
		respond @lifecycle "Not available" 403
		reverse_proxy prometheus:9090 {
			header_up -Cookie
		}
	}
}


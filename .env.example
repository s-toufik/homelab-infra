# `make env` creates .env from this file; `make secrets` then replaces every "changeme" password
# and secret with a random value and lists what is left for you (BIND_ADDR, HOMELAB_DOMAIN, LLM_BASE_URL).
# No "changeme" may remain: scripts/validate.sh refuses to start until every one is replaced.

# ---------- Host ----------
# This machine's Tailscale address (`tailscale ip -4`). Every published port listens on it only, so
# the stack is reachable from your tailnet's devices and nothing else; scripts/validate.sh checks it.
BIND_ADDR="<tailscale-ip>"
HOST_NAME=homelab
TZ=Europe/Paris

# ---------- Gateway (HTTPS + sign-in) ----------
# This machine's Tailscale name. Turn on MagicDNS and HTTPS certificates in the Tailscale
# admin console; homelab-ui is then https://<HOMELAB_DOMAIN>/ and sign-in https://<HOMELAB_DOMAIN>:8443/
HOMELAB_DOMAIN="<machine>.your-tailnet.ts.net"

# ---------- Image tags ----------
GRAFANA_TAG=12.0.2
PROMETHEUS_TAG=v3.4.1
LOKI_TAG=3.5.1
TEMPO_TAG=2.8.1
OTELCOL_TAG=0.128.0
ALLOY_TAG=v1.9.2
KAFKA_TAG=4.0.0
KAFKA_UI_TAG=v1.2.0
KAFKA_EXPORTER_TAG=v1.9.0
POSTGRES_EXPORTER_TAG=v0.20.1
MONGODB_EXPORTER_TAG=0.53.0
POSTGRES_TAG=17
POSTGREST_TAG=v16.4
DBMATE_TAG=2.36.0
CADDY_TAG=2.11.7
KEYCLOAK_TAG=26.8.1
OAUTH2_PROXY_TAG=v7.15.5
MONGO_TAG=7.0
CADVISOR_TAG=v0.60.5
LLAMA_SWAP_TAG=cpu
AGENT_TOOLBOX_TAG=latest
AGENT_RUNTIME_TAG=latest
MCP_INSPECTOR_TAG=2.13.0
HOMELAB_UI_TAG=latest

# ---------- Grafana ----------
# Local admin, for emergencies only (https://<HOMELAB_DOMAIN>:3000/login?disableAutoLogin):
# everyone else signs in with their Keycloak account. Don't reuse this name for a Keycloak account.
GRAFANA_ADMIN_USER=foo
# Generated
GRAFANA_ADMIN_PASSWORD=changeme

# ---------- Prometheus ----------
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=50GB

# ---------- Kafka (KRaft, single node) ----------
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_EXTERNAL_HOST=localhost

# ---------- PostgreSQL ----------
POSTGRES_USER=foo
# Applied when the PostgreSQL volume is first created — generated
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bar
# Login of the `postgrest` role (REST API for homelab-ui's Tasker) — generated
POSTGREST_PASSWORD=changeme

# ---------- Keycloak (sign-in accounts, stored in PostgreSQL database "keycloak") ----------
# Admin used only by the `make user-*` commands, inside the container — password generated
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
# Login of the `keycloak` database role — generated
KEYCLOAK_DB_PASSWORD=changeme

# ---------- Gateway secrets — all generated ----------
# Rotate one with `./scripts/secrets.sh --rotate <NAME>` then `make up` (keycloak-sync updates
# Keycloak's copy). `make sessions-revoke` rotates OAUTH2_PROXY_COOKIE_SECRET to sign everyone out.
OAUTH2_PROXY_CLIENT_SECRET=changeme
OAUTH2_PROXY_COOKIE_SECRET=changeme
TASKER_GATEWAY_SECRET=changeme
# Grafana signs in with Keycloak using this client secret
GRAFANA_OIDC_CLIENT_SECRET=changeme
# Scripts and OpenAI clients call https://<HOMELAB_DOMAIN>:8090/v1 with "Authorization: Bearer <key>"
LLM_GATEWAY_API_KEY=changeme

# ---------- MongoDB ----------
MONGO_ROOT_USER=foo
# Applied when the MongoDB volume is first created — generated
MONGO_ROOT_PASSWORD=changeme

# ---------- agent-runtime ----------
# http://<HOMELAB_DOMAIN>:8000 from the tailnet's devices; WEB_DOCS=true serves its API docs at /docs
GUARDRAIL_ENABLED=true
WEB_DOCS=true
MAX_CONCURRENT_STREAMS=200
AGENT_ANSWER_DELIVERY=stream

# ---------- agent-toolbox ----------
# http://<HOMELAB_DOMAIN>:8001/mcp from the tailnet's devices. It answers to <HOMELAB_DOMAIN>:8001 and
# <BIND_ADDR>:8001; list other names clients use here, comma-separated, e.g. the short MagicDNS name:
# TOOLBOX_EXTRA_ALLOWED_HOSTS="<machine>:8001"

# ---------- LLM Provider ----------
# Required by agent-runtime: an OpenAI-compatible API, e.g. NVIDIA's https://integrate.api.nvidia.com/v1
# with its API key, or http://llm:8080/v1 for the local llama-swap (the key may then stay empty)
LLM_BASE_URL=
LLM_API_KEY=

# ---------- Logging ----------
LOG_LEVEL=INFO

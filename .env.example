# Copy to .env and adjust:  cp .env.example .env
# Every "changeme" value MUST be replaced (scripts/validate.sh enforces it).
# `make secrets` replaces the generated ones (marked "generated") with random values for you.

# ---------- Host ----------
# 0.0.0.0 = reachable from your LAN !!! (make sure you understand this)
# 127.0.0.1 = only from the machine itself
# tailscale ip -4 only from the tailscale network
BIND_ADDR=0.0.0.0
HOST_NAME=homelab
TZ=Europe/Paris

# ---------- Gateway (HTTPS + sign-in) ----------
# This machine's Tailscale name. Turn on MagicDNS and HTTPS certificates in the Tailscale
# admin console; homelab-ui is then https://<HOMELAB_DOMAIN>/ and sign-in https://<HOMELAB_DOMAIN>:8443/
HOMELAB_DOMAIN=sirius.your-tailnet.ts.net

# ---------- Image tags ----------
GRAFANA_TAG=12.0.2
PROMETHEUS_TAG=v3.4.1
LOKI_TAG=3.5.1
TEMPO_TAG=2.8.1
OTELCOL_TAG=0.128.0
ALLOY_TAG=v1.9.2
KAFKA_TAG=4.0.0
KAFKA_UI_TAG=v1.2.0
KAFKA_EXPORTER_TAG=v1.9.0
POSTGRES_EXPORTER_TAG=v0.20.1
MONGODB_EXPORTER_TAG=0.53.0
POSTGRES_TAG=17
POSTGREST_TAG=v16.4
DBMATE_TAG=2.36.0
CADDY_TAG=2.11.7
KEYCLOAK_TAG=26.8.1
OAUTH2_PROXY_TAG=v7.15.5
MONGO_TAG=7.0
CADVISOR_TAG=v0.60.5
LLAMA_SWAP_TAG=cpu
AGENT_TOOLBOX_TAG=latest
AGENT_RUNTIME_TAG=latest
HOMELAB_UI_TAG=latest

# ---------- Grafana ----------
# Local admin, for emergencies only (https://<HOMELAB_DOMAIN>:3000/login?disableAutoLogin):
# everyone else signs in with their Keycloak account. Don't reuse this name for a Keycloak account.
GRAFANA_ADMIN_USER=foo
GRAFANA_ADMIN_PASSWORD=changeme

# ---------- Prometheus ----------
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=50GB

# ---------- Kafka (KRaft, single node) ----------
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_EXTERNAL_HOST=localhost

# ---------- PostgreSQL ----------
POSTGRES_USER=foo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bar
# Login of the `postgrest` role (REST API for homelab-ui's Tasker) — generated
POSTGREST_PASSWORD=changeme

# ---------- Keycloak (sign-in accounts, stored in PostgreSQL database "keycloak") ----------
# Admin used only by the `make user-*` commands, inside the container — password generated
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
# Login of the `keycloak` database role — generated
KEYCLOAK_DB_PASSWORD=changeme

# ---------- Gateway secrets — all generated ----------
# Rotate one with `./scripts/secrets.sh --rotate <NAME>` then `make up` (keycloak-sync updates
# Keycloak's copy). `make sessions-revoke` rotates OAUTH2_PROXY_COOKIE_SECRET to sign everyone out.
OAUTH2_PROXY_CLIENT_SECRET=changeme
OAUTH2_PROXY_COOKIE_SECRET=changeme
TASKER_GATEWAY_SECRET=changeme
# Grafana signs in with Keycloak using this client secret
GRAFANA_OIDC_CLIENT_SECRET=changeme
# Scripts and OpenAI clients call https://<HOMELAB_DOMAIN>:8090/v1 with "Authorization: Bearer <key>"
LLM_GATEWAY_API_KEY=changeme

# ---------- MongoDB ----------
MONGO_ROOT_USER=foo
MONGO_ROOT_PASSWORD=changeme

# ---------- agent-runtime ----------
GUARDRAIL_ENABLED=true
WEB_DOCS=true
MAX_CONCURRENT_STREAMS=200
AGENT_ANSWER_DELIVERY=stream

# ---------- agent-toolbox ----------
TOOLBOX_EXTRA_ALLOWED_HOSTS=<name>:8001

# ---------- LLM Provider ----------
LLM_BASE_URL=
LLM_API_KEY=

# ---------- Logging ----------
LOG_LEVEL=INFO

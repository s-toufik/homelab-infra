# Copy to .env and adjust:  cp .env.example .env
# Every "changeme" value MUST be replaced (scripts/validate.sh enforces it).

# ---------- Host ----------
# 0.0.0.0 = reachable from your LAN !!! (make sure you understand this)
# 127.0.0.1 = only from the machine itself
# tailscale ip -4 only from the tailscale network
BIND_ADDR=0.0.0.0
HOST_NAME=homelab
TZ=Europe/Paris

# ---------- Image tags ----------
GRAFANA_TAG=12.0.2
PROMETHEUS_TAG=v3.4.1
LOKI_TAG=3.5.1
TEMPO_TAG=2.8.1
OTELCOL_TAG=0.128.0
ALLOY_TAG=v1.9.2
KAFKA_TAG=4.0.0
KAFKA_UI_TAG=v1.2.0
KAFKA_EXPORTER_TAG=v1.9.0
POSTGRES_TAG=17
MONGO_TAG=7.0
CADVISOR_TAG=v0.60.5
LLAMA_SWAP_TAG=cpu
AGENT_TOOLBOX_TAG=latest
AGENT_ORCHESTRATOR_TAG=latest
HOMELAB_UI_TAG=latest

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=foo
GRAFANA_ADMIN_PASSWORD=changeme

# ---------- Kafka UI ----------
KAFKA_UI_USER=foo
KAFKA_UI_PASSWORD=changeme

# ---------- Prometheus ----------
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=50GB

# ---------- Kafka (KRaft, single node) ----------
# Generate a new one with: docker run --rm apache/kafka:4.0.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Hostname/IP that clients OUTSIDE docker use to reach Kafka on port 9094 (e.g. your server's LAN IP)
KAFKA_EXTERNAL_HOST=localhost

# ---------- PostgreSQL ----------
POSTGRES_USER=foo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bar

# ---------- MongoDB ----------
MONGO_ROOT_USER=foo
MONGO_ROOT_PASSWORD=changeme

# ---------- agent-toolbox ----------
TOOLBOX_EXTRA_ALLOWED_HOSTS=sirius:8001